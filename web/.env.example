# Copy to .env.local for `npm run dev`, and to .dev.vars for `npm run preview`.
# In production set these with `npx wrangler secret put <NAME>` (NEXT_PUBLIC_* are inlined at build time).

# Auth0 Regular Web Application
AUTH0_DOMAIN=your-tenant.us.auth0.com
AUTH0_CLIENT_ID=
AUTH0_CLIENT_SECRET=
# 32+ random bytes: `openssl rand -hex 32`
AUTH0_SECRET=
APP_BASE_URL=http://localhost:3000
# Identifier of the Auth0 API that the Cloudflare backend verifies
AUTH0_AUDIENCE=https://api.beingingym

# Cloudflare API worker (api/)
NEXT_PUBLIC_API_URL=http://localhost:8787


# Inbox that "Contact us" opens a new Gmail message to
NEXT_PUBLIC_CONTACT_EMAIL=
