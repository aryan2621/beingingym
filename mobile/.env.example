# Copy to .env (gitignored). EXPO_PUBLIC_* values are bundled into the app, so never put secrets here.
EXPO_PUBLIC_AUTH0_DOMAIN=dev-as61rnkt41u84o0x.us.auth0.com
# Client ID of the Auth0 *Native* application for the mobile app
EXPO_PUBLIC_AUTH0_CLIENT_ID=
EXPO_PUBLIC_AUTH0_AUDIENCE=https://api.beingingym
# On a phone, use your laptop's LAN IP (run the API with `npx wrangler dev --ip 0.0.0.0`)
EXPO_PUBLIC_API_URL=http://192.168.1.10:8787
# Web dashboard, opened from the Profile screen
EXPO_PUBLIC_WEB_URL=http://192.168.1.10:3000
