{
    "$schema": "node_modules/wrangler/config-schema.json",
    "name": "beingingym-api",
    "main": "src/index.ts",
    "compatibility_date": "2026-09-01",
    "observability": { "enabled": true },
    "vars": {
        // Non-secret config. Secrets go in .dev.vars locally and `wrangler secret put` in prod.
        "WEB_ORIGIN": "https://beingingym-web.just-a-dev.workers.dev,http://localhost:3000"
    }
}
